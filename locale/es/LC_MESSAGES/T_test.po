"Rimworld Data:\n"
"{Path_to_Data}"
msgstr ""
"Datos de RimWorld:\n"
"{Path_to_Data}"

#: Text_grabber_settings.py:353
msgid "Select path to Rimworld Data"
msgstr "Seleccionar ruta a Datos de RimWorld"

#: Text_grabber_settings.py:359
msgid "Please specify the Data folder of the game, it will help to extract the text better. This is not necessary, but it allows you to find parent-child dependencies."
msgstr "Especifica la carpeta Data del juego; ayudará a extraer mejor el texto. No es obligatorio, pero permite encontrar dependencias padre-hijo."

#: Text_grabber_settings.py:366
msgid "Select MOD folder"
